{
	"name": "todo-points",
	"version": "1.0.4",
	"description": "Track your to-do progress over time. Tag checklist items with #pN points and project tags, then view a color-coded chart of points completed by day, week, or month.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"release": "node scripts/release.js"
	},
	"keywords": [],
	"author": "Paul Q. Peters",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.14",
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"esbuild": "0.17.3",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	}
}
